# Neon (GêLeads) — pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# PUBLIC_FORMULARIO_GLOBAL — só "1" liga o formulário global. Qualquer outro valor mantém o modal antigo.
PUBLIC_FORMULARIO_GLOBAL=0
# PUBLIC_FORMS_WIDGET_BASE — produção: https://forms.genesisapps.com.br
# No build com PUBLIC_FORMULARIO_GLOBAL=1, a base precisa começar com https:// e não pode conter localhost.
PUBLIC_FORMS_WIDGET_BASE=
# PUBLIC_FORMS_ID — flow-residencial
PUBLIC_FORMS_ID=
# PUBLIC_FORMS_REAL — só "1" em produção. Fora disso o widget abre em prévia.
PUBLIC_FORMS_REAL=0

# Supabase (tracking unificado acessos_user) — lidos em runtime via dotenv
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ID do site (Flow Residencial)
SITE_ID=3

# Em produção atrás do Nginx: true (usa última entrada de X-Forwarded-For)
TRUST_PROXY=true

# Opcional — GeoIP MaxMind (.mmdb). Vazio = sem geo.
# MAXMIND_DB_PATH=
