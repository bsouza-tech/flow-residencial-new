# Neon (GêLeads) — pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Tracker Gênesis (pageviews) — Edge Function Supabase
# Opcional. A página / é prerender e PUBLIC_* entra no HTML no build.
# Se esta variável não existir, o código usa o endereço público padrão do tracker.
# PUBLIC_TRACK_ENDPOINT=

# PUBLIC_FORMULARIO_GLOBAL — só "1" liga o formulário global. Qualquer outro valor mantém o modal antigo.
PUBLIC_FORMULARIO_GLOBAL=0
# PUBLIC_FORMS_WIDGET_BASE — produção: https://forms.genesisapps.com.br
# No build com PUBLIC_FORMULARIO_GLOBAL=1, a base precisa começar com https:// e não pode conter localhost.
PUBLIC_FORMS_WIDGET_BASE=
# PUBLIC_FORMS_ID — flow-residencial
PUBLIC_FORMS_ID=
# PUBLIC_FORMS_REAL — só "1" em produção. Fora isso o widget abre em prévia.
PUBLIC_FORMS_REAL=0
