---
import '../styles/global.css';
import { META_PIXEL_ID } from '../lib/metaPixel';
import { TRACKING_SITE_KEY } from '../data/site';
import { projectLocation } from '../data/pointsOfInterest';
import { optimizedFullSrc } from '../data/optimizedImages';
import consentJs from '../../public/consent.js?raw';
import montserratLatin from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import openSansLatin from '@fontsource-variable/open-sans/files/open-sans-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Flow Residencial em Teresópolis | Plantas e Lazer | Gênesis',
  description = 'Conheça o Flow Residencial em N. S. de Fátima, Teresópolis. Explore plantas Estúdio, Double Suite, Cobertura Double Suite e Dois Quartos PCD.',
} = Astro.props;

const trackEndpoint =
  import.meta.env.PUBLIC_TRACK_ENDPOINT ||
  'https://gbyhwfamevtityuzzrhn.supabase.co/functions/v1/track';
const siteUrl = 'https://flowresidencial.com.br';
const canonicalUrl = `${siteUrl}/`;
const ogImage = `${siteUrl}/og-flow-residencial.jpg`;

const placeLine = projectLocation.addressLines[1];
const addressLocality = placeLine.split(', ').pop()?.split(' — ')[0];
const addressRegion = placeLine.split(' — ')[1];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ApartmentComplex',
      '@id': `${siteUrl}/#apartmentcomplex`,
      name: projectLocation.name,
      description,
      url: canonicalUrl,
      image: ogImage,
      telephone: '+552126421203',
      address: {
        '@type': 'PostalAddress',
        streetAddress: projectLocation.addressLines[0],
        addressLocality,
        addressRegion,
        postalCode: projectLocation.addressLines[2].replace(/^CEP\s+/, ''),
        addressCountry: 'BR',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: projectLocation.lat,
        longitude: projectLocation.lng,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Gênesis Empreendimentos',
      url: 'https://genesisempreendimentos.com.br',
      logo: `${siteUrl}${optimizedFullSrc('genesis-logo')}`,
      telephone: '+552126421203',
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!document.documentElement.hasAttribute('data-reveal-ready')) {
          document.querySelectorAll('[data-reveal]').forEach(function (el) {
            el.setAttribute('data-revealed', '');
          });
          document.documentElement.classList.remove('js');
        }
      }, 4000);
      document.addEventListener('DOMContentLoaded', function () {
        if (!('IntersectionObserver' in window)) return;
        var timers = new WeakMap();
        var show = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            var el = entry.target;
            if (el.hasAttribute('data-revealed')) {
              show.unobserve(el);
              return;
            }
            var pending = timers.get(el);
            if (entry.isIntersecting) {
              if (pending) return;
              timers.set(
                el,
                setTimeout(function () {
                  timers.delete(el);
                  if (el.hasAttribute('data-revealed')) return;
                  var prev = el.style.transition;
                  el.style.transition = 'none';
                  el.setAttribute('data-revealed', '');
                  void el.offsetWidth;
                  el.style.transition = prev;
                  show.unobserve(el);
                }, 2500)
              );
            } else if (pending) {
              clearTimeout(pending);
              timers.delete(el);
            }
          });
        });
        document.querySelectorAll('[data-reveal]:not([data-revealed])').forEach(function (el) {
          show.observe(el);
        });
      });
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fachada do Flow Residencial em Teresópolis" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Flow Residencial" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Fachada do Flow Residencial em Teresópolis" />

    <meta name="theme-color" content="#161724" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />

    <link
      rel="preload"
      href={montserratLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={openSansLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline set:html={consentJs} />
    <script
      is:inline
      src="/tracker.js"
      defer
      data-site-key={TRACKING_SITE_KEY}
      data-endpoint={trackEndpoint}
      data-requires-consent="true"
      data-sections="hero,beneficios,plantas,galeria,benfeitorias,localizacao,interesse,sobre"
    ></script>
    <script is:inline define:vars={{ META_PIXEL_ID, PIXEL_ENABLED: import.meta.env.PROD }}>
      (function () {
        if (!PIXEL_ENABLED) return;

        var initialized = false;
        var pageViewSent = false;

        function loadMetaPixel() {
          if (!window.GenesisConsent || window.GenesisConsent.get() !== 'granted') return;

          if (!initialized) {
            initialized = true;

            !(function (f, b, e, v, n, t, s) {
              if (f.fbq) return;
              n = f.fbq = function () {
                n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
              };
              if (!f._fbq) f._fbq = n;
              n.push = n;
              n.loaded = !0;
              n.version = '2.0';
              n.queue = [];
              t = b.createElement(e);
              t.async = !0;
              t.src = v;
              s = b.getElementsByTagName(e)[0];
              s.parentNode.insertBefore(t, s);
            })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

            fbq('init', META_PIXEL_ID);
          }

          if (!pageViewSent && typeof fbq === 'function') {
            fbq('track', 'PageView');
            pageViewSent = true;
          }
        }

        if (window.GenesisConsent) {
          window.GenesisConsent.onChange(function (status) {
            if (status === 'granted') loadMetaPixel();
          });
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        var watching = null;
        var resizeObserver = new ResizeObserver(apply);

        function apply() {
          var bar = document.querySelector('.site-header__bar');
          if (!bar) return;
          var bottom = Math.ceil(bar.getBoundingClientRect().bottom);
          if (bottom <= 0) return;
          document.documentElement.style.scrollPaddingTop = bottom + 'px';
        }

        function bind() {
          var bar = document.querySelector('.site-header__bar');
          if (!bar || bar === watching) return !!bar;
          if (watching) resizeObserver.unobserve(watching);
          watching = bar;
          resizeObserver.observe(bar);
          apply();
          return true;
        }

        if (!bind()) {
          var timer = setInterval(function () {
            if (bind()) clearInterval(timer);
          }, 50);
        }
        window.addEventListener('resize', apply);
        new MutationObserver(bind).observe(document.body, { childList: true, subtree: true });
      })();
    </script>
    <script>
      import { installFormularioGlobal } from '../scripts/formulario-global';

      if (import.meta.env.PUBLIC_FORMULARIO_GLOBAL === '1') {
        installFormularioGlobal();
      }
    </script>
  </body>
</html>
